        </mxCell>
        <mxCell id="m2" value="Export to ONNX&lt;br&gt;(export_model.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="870" width="170" height="70" as="geometry" />
