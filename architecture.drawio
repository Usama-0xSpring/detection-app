        <mxCell id="m3" value="Upload new version&lt;br&gt;to Blob (v2/model.onnx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
