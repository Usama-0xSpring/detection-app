          <mxGeometry x="985" y="735" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ghcr_note" value="The VM does not poll the registry: the deploy job tells it to pull." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry y="374" width="190" height="36" x="830" as="geometry" />
