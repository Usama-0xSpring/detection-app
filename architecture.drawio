        </mxCell>
        <mxCell id="em4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;flowAnimation=1;strokeColor=#82b366;" edge="1" parent="1" source="m4" target="m5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mnote" value="Rollback: re-run with the previous MODEL_URL and MODEL_SHA256" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1270" y="880" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;1 git push to main  |  2 workflow triggers  |  3 deploy job runs after CI passes (no approval)  |  4 GitHub Actions tells the VM over SSH to run docker compose pull + up -d  |  5 the VM downloads the images from GHCR&lt;br&gt;6 backend downloads model.onnx from Blob and verifies SHA256 (first start only)  |  7 nginx proxies /api to FastAPI  |  8 user sends an HTTP request to the VM public IP&lt;br&gt;9 JSON detections returned, bounding boxes drawn in the browser  |  10 logs and metrics" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#1f2a44;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="975" width="1360" height="90" as="geometry" />
        </mxCell>
