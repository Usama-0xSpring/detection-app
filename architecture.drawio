        <mxCell id="log" value="&lt;b&gt;Logging and monitoring (basic)&lt;/b&gt;&lt;br&gt;GitHub Actions run logs&lt;br&gt;docker compose logs on the VM&lt;br&gt;Azure portal VM metrics&lt;br&gt;Cost Management budget alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=2;fontSize=12;;shape=label;image=img/lib/azure2/management_governance/Monitor.svg;imageAlign=left;imageVerticalAlign=middle;imageWidth=40;imageHeight=40;spacingLeft=48;spacingRight=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="520" y="700" width="520" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cleanup" value="&lt;b&gt;Cleanup:&lt;/b&gt; az group delete -n rg-demo --yes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1350" y="700" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mtitle" value="Model update flow (no image rebuild)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1a7f5a;" vertex="1" parent="1">
          <mxGeometry x="220" y="835" width="500" height="25" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Train on&lt;br&gt;Colab / Kaggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
